# Bu dosyayı .env olarak kopyala ve değerleri doldur. .env asla git'e girmez.
PORT=3000

# Aktif proje: projects/<PROJECT>/project.json okunur
PROJECT=yonerge

# Google AI Studio'dan alınır. LLM cevabı (rag/answer.py) için gerekir. Ücretsiz plan: dakikada 15 istek.
GEMINI_API_KEY=

# Vektör veritabanı (project.json › vectorStore.type = "pgvector"). Boş bırakılırsa docker/db.env okunur.
# DATABASE_URL=postgresql://tkpark:sifre@localhost:5432/tkpark
