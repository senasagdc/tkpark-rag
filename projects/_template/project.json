{
  "id": "_template",
  "name": "Yeni Proje Asistanı",
  "language": "tr",

  "sources": [
    {
      "path": "data/belge.pdf",
      "type": "pdf",
      "title": "Belgenin tam adı",
      "skipPages": []
    }
  ],

  "chunking": {
    "strategy": "fixed",
    "maxTokens": 300,
    "overlap": 50
  },

  "embedding": {
    "model": "intfloat/multilingual-e5-base",
    "passagePrefix": "passage: ",
    "queryPrefix": "query: "
  },
  "vectorStore": { "type": "flat" },
  "llm":       { "provider": "gemini", "model": "gemini-3.5-flash-lite", "temperature": 0.1 },
  "routing": {
    "scope": "Belgenin adı ve kapsadığı konular, tek cümle",
    "minChars": 3,
    "maxChars": 1000,
    "temperature": 0.0
  },
  "retrieval": { "topK": 5, "minScore": 0.0 },

  "prompts": {
    "routing": "prompts/routing.md",
    "system": "prompts/system.md",
    "messages": "prompts/messages.json",
    "vars": { "organization": "Kurum adı", "assistantName": "Asistan adı" }
  },

  "guardrails": "guardrails/rules.json",

  "ui": {
    "title": "Asistan",
    "welcome": "Bu belge hakkında soru sorabilirsiniz.",
    "examples": []
  }
}
